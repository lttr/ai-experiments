{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "prettier --list-different --write . --",
    "generate": "nuxt generate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "test": "exit 0",
    "verify": "npm run format && npm run lint:fix && npm run typecheck && npm test",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "nuxt": "^4.2.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@lttr/nuxt-config-eslint": "^0.4.0",
    "@lttr/nuxt-puleo": "^0.0.8",
    "@nuxt/eslint": "^1.10.0",
    "@nuxt/fonts": "^0.12.1",
    "@vueuse/nuxt": "^14.0.0",
    "eslint": "^9.39.1",
    "typescript": "^5.7.3"
  }
}
